<?xml version="1.0" encoding="utf-8"?>
<!-- Der Pager-Server liefert nur http. Unverschlüsselter Zugriff wird erlaubt,
     damit auch eine geänderte Server-Adresse in den Einstellungen funktioniert. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
